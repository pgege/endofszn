{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/api/src",
  "targets": {
    "serve": {
      "command": "nest start --watch",
      "options": {
        "cwd": "apps/api"
      }
    },
    "build": {
      "command": "nest build",
      "options": {
        "cwd": "apps/api"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "start": {
      "command": "node dist/main",
      "options": {
        "cwd": "apps/api"
      },
      "dependsOn": ["build"]
    },
    "db:generate": {
      "command": "prisma generate --config=apps/api/prisma.config.ts"
    },
    "db:migrate": {
      "command": "prisma migrate dev --config=apps/api/prisma.config.ts"
    },
    "db:migrate:prod": {
      "command": "prisma migrate deploy --config=apps/api/prisma.config.ts"
    },
    "db:push": {
      "command": "prisma db push --config=apps/api/prisma.config.ts"
    },
    "db:studio": {
      "command": "prisma studio --config=apps/api/prisma.config.ts"
    },
    "typecheck": {
      "command": "tsc --noEmit",
      "options": {
        "cwd": "apps/api"
      }
    }
  }
}
