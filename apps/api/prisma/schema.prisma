generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Workflow {
  id          String        @id @default(uuid())
  vendorId    String
  name        String
  description String?
  definition  Json
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  runs        WorkflowRun[]

  @@index([vendorId])
}

model WorkflowRun {
  id           String    @id @default(uuid())
  vendorId     String
  workflowId   String?
  workflow     Workflow?  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  title        String?
  authToken    String?
  agentHistory Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  messages     Message[]

  @@index([vendorId])
  @@index([workflowId])
}

model Message {
  id            String       @id @default(uuid())
  workflowRunId String
  workflowRun   WorkflowRun  @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)
  role          String
  type          String
  content       String
  data          Json?
  attachments   Attachment[]
  createdAt     DateTime     @default(now())

  @@index([workflowRunId])
}

model Attachment {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  url       String
  filename  String
  mimeType  String
  source    String
  createdAt DateTime @default(now())

  @@index([messageId])
}

model StoreConfig {
  id        String   @id @default(cuid())
  storeId   String   @unique
  sandboxId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
